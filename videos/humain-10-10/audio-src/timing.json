   "beats": 8,
   "sentences": [
    {
     "line": 1,
     "idx": 0,
     "text": "T'es à cinquante secondes de savoir exactement quoi faire pour tout changer.",
     "start": 0.2727,
     "dur": 3.606
    }
   ]
  },
  {
   "id": "s02-salle",
   "start": 4.3636,
   "dur": 7.0909,
   "beats": 13,
   "sentences": [
    {
     "line": 2,
     "idx": 0,
     "text": "La salle.",
     "start": 0.2727,
     "dur": 0.643
    },
    {
     "line": 2,
     "idx": 1,
     "text": "Trois fois par semaine minimum.",
     "start": 1.0909,
     "dur": 1.547
    },
    {
     "line": 2,
     "idx": 2,
     "text": "Pas pour être bodybuilder.",
     "start": 2.8636,
     "dur": 1.866
    },
    {
     "line": 2,
     "idx": 3,
     "text": "Pour ne plus te sentir petit.",
     "start": 4.9091,
     "dur": 1.414
    }
   ]
  },
  {
   "id": "s03-eau-sommeil",
   "start": 11.4545,
   "dur": 11.4545,
   "beats": 21,
   "sentences": [
    {
     "line": 3,
     "idx": 0,
     "text": "Deux litres d'eau par jour.",
     "start": 0.2727,
     "dur": 1.494
    },
    {
     "line": 3,
     "idx": 1,
     "text": "Ta peau, ton énergie, ta concentration, tout change.",
     "start": 1.9091,
     "dur": 3.368
    },
    {
     "line": 4,
     "idx": 0,
     "text": "Dors avant minuit.",
     "start": 5.6771,
     "dur": 1.107
    },
    {
     "line": 4,
     "idx": 1,
     "text": "La testostérone monte pendant le sommeil.",
     "start": 6.9545,
     "dur": 2.235
    },
    {
     "line": 4,
     "idx": 2,
     "text": "Huit heures, pas sept.",
     "start": 9.4091,
     "dur": 1.322
    }
   ]
  },
  {
   "id": "s04-lecture",
   "start": 22.9091,
   "dur": 7.6364,
   "beats": 14,
   "sentences": [
    {
     "line": 5,
     "idx": 0,
     "text": "Lis dix pages par jour.",
     "start": 0.2727,
     "dur": 1.46
    },
    {
     "line": 5,
     "idx": 1,
     "text": "N'importe quel livre qui t'apprend quelque chose.",
     "start": 1.9091,
     "dur": 2.313
    },
    {
     "line": 5,
     "idx": 2,
     "text": "Dans un an, t'as lu douze livres de plus que tes potes.",
     "start": 4.3636,
     "dur": 2.65
    }
   ]
  },
  {
   "id": "s05-meditation-entourage",
   "start": 30.5455,
   "dur": 13.6364,
   "beats": 25,
   "sentences": [
    {
     "line": 6,
     "idx": 0,
     "text": "Médite cinq minutes le matin.",
     "start": 0.2727,
     "dur": 1.632
    },
    {
     "line": 6,
     "idx": 1,
     "text": "Pas pour être zen.",
     "start": 2.0455,
     "dur": 1.403
    },
    {
     "line": 6,
     "idx": 2,
     "text": "Pour que ton cerveau arrête de partir dans tous les sens.",
     "start": 3.6818,
     "dur": 2.74
    },
    {
     "line": 7,
     "idx": 0,
     "text": "Coupe les gens qui drainent ton énergie.",
     "start": 6.8218,
     "dur": 2.1
    },
    {
     "line": 7,
     "idx": 1,
     "text": "Pas de drama.",
     "start": 9.1364,
     "dur": 0.713
    },
    {
     "line": 7,
     "idx": 2,
     "text": "Juste distance.",
     "start": 10.0909,
     "dur": 1.155
    },
    {
     "line": 7,
     "idx": 3,
     "text": "Ton niveau monte avec ton entourage.",
     "start": 11.4545,
     "dur": 1.622
    }
   ]
  },
  {
